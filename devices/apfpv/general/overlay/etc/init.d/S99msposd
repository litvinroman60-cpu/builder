#!/bin/sh

case "$1" in
	start)
		# wifibroadcast-ng owns the MSPOSD process on APFPV. Starting another
		# instance would contend for the same UART and could prevent telemetry.
		if [ -x /usr/bin/wifibroadcast ] && [ -r /etc/wfb.yaml ] &&
			grep -q '^[[:space:]]*router:[[:space:]]*msposd[[:space:]]*		sleep 1
		size=$(curl -s localhost/api/v1/config.json | jsonfilter -qe "@.video0.size")
		if [ -z "$size" ]; then
			size=1280x720
			echo "Warning: could not read video0.size; using $size for MSPOSD layout"
		fi
		port=/dev/ttyS2
		baud=115200
		if [ -r /etc/apfpv-msposd.conf ]; then
			. /etc/apfpv-msposd.conf
		fi
		case "$port" in /dev/ttyS0|/dev/ttyS1|/dev/ttyS2) ;; *) port=/dev/ttyS2 ;; esac
		case "$baud" in 9600|19200|38400|57600|115200) ;; *) baud=115200 ;; esac
		msposd -b "$baud" -c 8 -r 20 -m "$port" -z "$size" -s > /tmp/msposd.log 2>&1 &
		;;

	stop)
		echo "Stopping msposd..."
		killall -q msposd
		;;

	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
 /etc/wfb.yaml; then
			echo "MSPOSD is managed by wifibroadcast; skipping duplicate instance"
			exit 0
		fi
		echo "Starting standalone msposd..."
		devmem 0x1F207890 16 0x8
		sleep 1
		size=$(curl -s localhost/api/v1/config.json | jsonfilter -qe "@.video0.size")
		if [ -z "$size" ]; then
			size=1280x720
			echo "Warning: could not read video0.size; using $size for MSPOSD layout"
		fi
		port=/dev/ttyS2
		baud=115200
		if [ -r /etc/apfpv-msposd.conf ]; then
			. /etc/apfpv-msposd.conf
		fi
		case "$port" in /dev/ttyS0|/dev/ttyS1|/dev/ttyS2) ;; *) port=/dev/ttyS2 ;; esac
		case "$baud" in 9600|19200|38400|57600|115200) ;; *) baud=115200 ;; esac
		msposd -b "$baud" -c 8 -r 20 -m "$port" -z "$size" -s > /tmp/msposd.log 2>&1 &
		;;

	stop)
		echo "Stopping msposd..."
		killall -q msposd
		;;

	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
