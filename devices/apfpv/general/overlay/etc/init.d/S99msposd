#!/bin/sh

case "$1" in
	start)
		# When telemetry is configured for MSPOSD, wifibroadcast owns
		# the process. Do not start a second instance on the same UART.
		if [ -x /usr/bin/wifibroadcast ] && [ -r /etc/wfb.yaml ] &&
			grep -q '^[[:space:]]*router:[[:space:]]*msposd[[:space:]]*$' /etc/wfb.yaml; then
			echo "MSPOSD is managed by wifibroadcast; skipping duplicate instance"
			exit 0
		fi

		echo "Starting standalone msposd..."
		devmem 0x1F2079B8 16 0x1000
		sleep 1

		size=$(curl -s localhost/api/v1/config.json | jsonfilter -qe "@.video0.size")
		if [ -z "$size" ]; then
			size=1920x1080
			echo "Warning: could not read video0.size; using $size for MSPOSD layout"
		fi

		port=/dev/ttyS2
		baud=115200
		if [ -r /etc/apfpv-msposd.conf ]; then
			. /etc/apfpv-msposd.conf
		fi

		case "$port" in
			/dev/ttyS0|/dev/ttyS1|/dev/ttyS2) ;;
			*) port=/dev/ttyS2 ;;
		esac
		case "$baud" in
			9600|19200|38400|57600|115200) ;;
			*) baud=115200 ;;
		esac

		# Use the font matrix that matches the configured video size.
		# Keep AHI disabled: it is a graphical layer, not text OSD.
		case "$size" in
			1280x720)
				matrix=1
				[ -r /usr/share/fonts/font_btfl_hd.png ] && ln -sf /usr/share/fonts/font_btfl_hd.png /usr/bin/font_hd.png
				;;
			*)
				matrix=0
				;;
		esac

		# Record the resolved APFPV settings separately; msposd owns /tmp/msposd.log.
		{
			echo "APFPV MSPOSD startup: $(date)"
			echo "video_size=$size matrix=$matrix uart=$port baud=$baud"
			for font in /usr/share/fonts/font_btfl.png /usr/share/fonts/font_btfl_hd.png; do
				if [ -r "$font" ]; then
					ls -l "$font"
				else
					echo "WARNING: font missing or unreadable: $font"
				fi
			done
		} > /tmp/msposd-startup.log 2>&1

		# This build expects the font option and matrix as separate arguments.
		# Keep this change in the APFPV overlay; the standalone FPV target is untouched.
		msposd -b "$baud" -r 20 -m "$port" -z "$size" -d -x 11 "$matrix" > /tmp/msposd.log 2>&1 &
		;;

	stop)
		echo "Stopping msposd..."
		killall -q msposd
		;;

	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
